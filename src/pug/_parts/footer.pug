footer.l-footer
  div.l-footer__wrapper
    div.l-footer__logo
      a(href="#home")
        div.l-footer__logo-icon
          span W
        div.l-footer__logo-content
          strong WINSTON POTTER
          p Professional Lawyer

    nav.l-footer__nav.l-global-nav
      ul.l-global-nav__list
        li.l-global-nav__item
          a.l-global-nav__link(href="#home") Home
        li.l-global-nav__item
          a.l-global-nav__link(href="#about") About
        li.l-global-nav__item
          a.l-global-nav__link.is-active(href="#services") Services
        li.l-global-nav__item
          a.l-global-nav__link(href="#contact") Article
        li.l-global-nav__item
          a.l-global-nav__link(href="#projects") Projects
        li.l-global-nav__item
          a.l-global-nav__link(href="#contact") Contact

    div.l-footer__utilities
      ul.c-list.c-list--inline
        li.c-list__item
          a.c-link.c-link--inline(href="https://www.facebook.com/" target="_blank" rel="noopener")
            img(src=path + "/img/common/header_logo_facebook.svg" alt="Facebook" width="16" height="16" loading="eager")

        li.c-list__item
          a.c-link.c-link--inline(href="https://www.facebook.com/" target="_blank" rel="noopener")
            img(src=path+"/img/common/header_logo_twitter.svg" alt="Twitter" width="16" height="16" loading="eager")

        li.c-list__item
          a.c-link.c-link--inline(href="https://www.facebook.com/" target="_blank" rel="noopener")
            img(src=path+"/img/common/header_logo_linked.svg" alt="Linked" width="16" height="16" loading="eager")

        li.c-list__item
          a.c-link.c-link--inline(href="https://www.facebook.com/" target="_blank" rel="noopener")
            img(src=path+"/img/common/header_logo_media.svg" alt="Facebook" width="16" height="16" loading="eager")

  div.l-footer__divider

  div.l-footer__copyright
    small © 2022 Winston Potter
